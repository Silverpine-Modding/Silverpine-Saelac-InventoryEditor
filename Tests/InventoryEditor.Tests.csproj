<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SilverpineGameDir Condition="'$(SilverpineGameDir)' == ''">$(MSBuildProjectDirectory)\..\..\..</SilverpineGameDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\GeneratedItemText.cs" Link="GeneratedItemText.cs" />
    <Compile Include="..\InventoryService.cs" Link="InventoryService.cs" />
    <Compile Include="..\CharacterValues.cs" Link="CharacterValues.cs" />
    <Compile Include="..\ItemEditing.cs" Link="ItemEditing.cs" />
    <Reference Include="Mono.Cecil"><HintPath>$(SilverpineGameDir)\BepInEx\core\Mono.Cecil.dll</HintPath></Reference>
  </ItemGroup>
</Project>
